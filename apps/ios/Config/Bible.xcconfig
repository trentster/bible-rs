// Identity and signing. Simulator builds need none of it. For a device, put your own values in
// Local.xcconfig next to this file (git ignores it), for example:
//
//   DEVELOPMENT_TEAM = ABCDE12345
//   BIBLE_BUNDLE_ID = com.example.bible
// ONE SETTING, ONE LINE. Mark's identifiers:
//   now, free cable installs on his phone:  au.com.onyxit.lamplit.dev
//   TestFlight and the App Store, later:    au.com.onyxit.lamplit
// The store identifier is created with Mark's paid account and must not be registered or used
// before then, so the dev build carries the .dev one. Switching is this line and nothing else.
BIBLE_BUNDLE_ID = au.com.onyxit.lamplit.dev
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

MARKETING_VERSION = 0.0.0
CURRENT_PROJECT_VERSION = 1
#include? "../Generated/Version.xcconfig"
#include? "Local.xcconfig"
